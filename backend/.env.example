PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eesa
# At least 32 random characters; the server refuses to start in production otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email – Brevo (primary: REST API, fallback: SMTP)
BREVO_API_KEY=your_brevo_api_key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=your_email@example.com

# M-Pesa Daraja API (optional – for mobile payments)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-backend.onrender.com/api/payments/mpesa/callback
# "sandbox" (the default) with Daraja test credentials, or "production" for real payments.
MPESA_ENV=sandbox

# Membership fees in whole shillings. M-Pesa charges exactly these amounts, and
# a fee that is not set cannot be paid by M-Pesa.
REGISTRATION_FEE=
RENEWAL_FEE=

# Merchandise shop (optional). Orders are collected in person; unpaid orders
# release their stock after ORDER_HOLD_HOURS. Members who pay outside the app are
# shown the paybill below (default: 522522, account 1286744210) and any extra
# SHOP_PAYMENT_INSTRUCTIONS.
SHOP_PICKUP_LOCATION=the EESA office
SHOP_PAYBILL=522522
SHOP_ACCOUNT=1286744210
SHOP_PAYMENT_INSTRUCTIONS=
ORDER_HOLD_HOURS=72

# Month the academic year starts, 1-12 (default 9, September). Membership
# certificates are issued per academic year.
ACADEMIC_YEAR_START_MONTH=9

# Rate limits per IP per 15 minutes (optional)
RATE_LIMIT_MAX=600
WRITE_RATE_LIMIT_MAX=150

# First administrator, used only by `npm run seed`.
# Leave SEED_ADMIN_PASSWORD empty to have a strong one generated and printed once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FIRST_NAME=EESA
SEED_ADMIN_LAST_NAME=Administrator

# Superadmin password for `npm run superadmin -- grant|reset-password`.
# Leave empty to have a strong one generated and printed once.
SUPERADMIN_PASSWORD=

# Emergency override for the kill switch. Leave unset normally.
# off: reopen the site whatever Platform Control says; on: close it for
# everyone but the superadmin; read_only: freeze it.
# MAINTENANCE_OVERRIDE=off
