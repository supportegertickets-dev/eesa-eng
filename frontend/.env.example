NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Public site address, used for canonical links, sitemap.xml, robots.txt and
# social sharing previews. Keep localhost for local development; production
# should use https://eesa.co.ke after its DNS and HTTPS are working.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Meta-tag verification tokens from Google Search Console and Bing Webmaster
# Tools (optional). Separate several with commas.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
